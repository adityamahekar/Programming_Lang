function cartReducer(state, action){
  switch(action.type){
    case 'product_added':
      return [...state, action.product]
    case 'product_removed':
      return state.filter(p => p.id !== action.id)
  }
}


const [cart, dispatch] = useReducer(cartReducer, [])
