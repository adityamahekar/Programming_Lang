function useCounter(){
  const [count, setCount] = useState(0)
  function increase(){
    setCount(count + 1)
  }
  return { count, increase }
}


function ProductCard(){
  const {count, increase } = useCounter()
  return <button onClick={increase}> {count} </button>
}

