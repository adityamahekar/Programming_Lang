import { Text, View, Image, Button, useColorScheme, TouchableOpacity, TouchableHighlight, Alert, Pressable, StyleSheet } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';


////////// user Input ///////////

import React, { useState } from 'react';
 import { TextInput } from 'react-native';
  
const App = () => {

  const [firstName, setFirstName] = useState('');
  const [submitted, setSubmitted] = useState('');

 const handleSubmit = () => {
    setSubmitted(firstName);
    setFirstName('');
  };

  return (
    <SafeAreaView style={styles.container} >
      <Text style={styles.title}> WellCome </Text>
      <TextInput placeholder=" ˶ᵔ ᵕ ᵔ˶ Type " style={styles.input} value={firstName} onChangeText={setFirstName} multiline={true} numberOfLines={4} keyboardType="numeric"/>
            <Button title="Submit" onPress={handleSubmit} />
      {submitted ? (<Text>Result: {submitted}</Text>): null}
    </SafeAreaView>
  );
};

export default App;

const styles = StyleSheet.create({
  container: {  flex: 1, backgroundColor: 'lightgreen',alignItems: 'center', justifyContent: 'center',gap: 20 },
  title: { fontSize: 24, fontWeight: 'bold' },
  input: { width: '80%', height: 40, borderColor: 'gray', borderWidth: 1, borderRadius: 5, paddingHorizontal: 10, marginTop: 20 }
})
